{
  "name": "wise-desktop",
  "productName": "WISE CONSULTING",
  "version": "1.3.0",
  "description": "WISE CONSULTING – десктоп апликација (app.wiseconsulting.com.mk)",
  "author": "WISE CONSULTING",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test \"fiscal/test/*.test.js\""
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "mk.com.wiseconsulting.app",
    "productName": "WISE CONSULTING",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "fiscal.js",
      "preload.js",
      "fiscal/**/*.js",
      "!fiscal/test/**",
      "package.json",
      "build/icon.ico",
      "build/icon.png",
      "updater.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "include": "installer/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WISE CONSULTING",
      "artifactName": "WISE-Setup-${version}.exe"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@serialport/bindings-cpp/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.wiseconsulting.com.mk/api/desktop-update"
      }
    ]
  }
}
