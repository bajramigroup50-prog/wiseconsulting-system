{
	email {$ACME_EMAIL}
	# Clients connecting by IP send no SNI; serve the IP_HOST certificate to them.
	default_sni {$IP_HOST:localhost}
}

# Office-only access: ALLOW_IPS in /opt/wise/.env (space-separated IPs / CIDRs). Empty = open to everyone.
# Any other address gets the connection closed without a response (no login page, nothing to find).
(office_only) {
	@outside not remote_ip {$ALLOW_IPS}
	abort @outside
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}

{$DOMAIN} {
	import office_only
	encode zstd gzip
	import security
	request_body {
		max_size 110MB
	}
	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Presigned uploads/downloads go straight to the S3 store (SeaweedFS S3 API only).
files.{$DOMAIN} {
	import office_only
	request_body {
		max_size 110MB
	}
	reverse_proxy s3:8333 {
		header_up Host {host}
	}
}

# Temporary access by IP address before DNS works (self-signed certificate, browser warning).
# Set IP_HOST=<server ip> in .env to enable; leave it empty in production. File uploads need files.DOMAIN.
{$IP_HOST:localhost} {
	tls internal
	import security
	reverse_proxy app:3000
}
