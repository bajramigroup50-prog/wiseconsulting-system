# Copy to docker/.env on the server and fill in. Never commit the real .env.

# Public domain (A records for DOMAIN and files.DOMAIN must point at the VPS)
DOMAIN=wise.example.mk
ACME_EMAIL=admin@example.mk

# PostgreSQL
POSTGRES_USER=wise
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=wise

# MinIO (also used by the app as S3 credentials)
MINIO_ROOT_USER=wise
MINIO_ROOT_PASSWORD=change-me-long-random
S3_BUCKET=wise-docs

# First administrator (created by the seed only when there are no users; must change password at first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Later phases
ANTHROPIC_API_KEY=
SMTP_URL=smtp://user:pass@smtp.example.mk:587
MAIL_FROM="WISE CONSULTING <office@example.mk>"
