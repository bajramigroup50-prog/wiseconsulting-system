# Copy to docker/.env on the server and fill in. Never commit the real .env.

# Public domain (A records for DOMAIN, www.DOMAIN and files.DOMAIN must point at the VPS)
DOMAIN=wise.example.mk
ACME_EMAIL=admin@example.mk
# Optional, temporary: serve the app on https://<IP_HOST> (self-signed) before DNS works
IP_HOST=

# 🔐 Enrolled computers (mutual TLS, docs/INSTALIM-UREDI.md): off | optional | required.
# Create the CA first (docker/device-ca.sh), then optional → enrol every computer → required.
DEVICE_CERTS=off
# Optional host paths (defaults shown): CA directory and the folder with the generic WISE-Setup.exe
# DEVICE_CA_HOST_DIR=/opt/wise/ca
# DEVICE_DOWNLOAD_HOST_DIR=/opt/wise/download

# PostgreSQL
POSTGRES_USER=wise
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=wise

# S3 document store (SeaweedFS) credentials
S3_ACCESS_KEY=wise
S3_SECRET_KEY=change-me-long-random
S3_BUCKET=wise-docs

# First administrator (created by the seed only when there are no users; must change password at first login)
ADMIN_USERNAME=1
ADMIN_PASSWORD=

# Later phases
ANTHROPIC_API_KEY=
SMTP_URL=smtp://user:pass@smtp.example.mk:587
MAIL_FROM="WISE CONSULTING <office@example.mk>"

# E-mail (Phase 6: payslips and other mail; used by the worker). Without SMTP_HOST (or SMTP_URL) messages are logged as failed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
