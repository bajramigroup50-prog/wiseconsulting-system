{
  "name": "wise-consulting",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @wise/db generate",
    "db:migrate": "pnpm --filter @wise/db migrate",
    "db:seed": "pnpm --filter @wise/db seed"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  }
}
